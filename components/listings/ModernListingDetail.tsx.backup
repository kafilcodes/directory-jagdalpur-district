                                              : "text-gray-300"                    <div className="flex gap-3">

                                          )}                      <Button size="icon" variant="outline">

                                        />                        <Facebook className="h-4 w-4" />

                                      ))}                      </Button>

                                    </div>                      <Button size="icon" variant="outline">

                                    {review.relativeTime && (                        <Instagram className="h-4 w-4" />

                                      <span className="text-xs text-gray-500 flex items-center gap-1">                      </Button>

                                        <Calendar className="h-3 w-3" />                      <Button size="icon" variant="outline">

                                        {review.relativeTime}                        <Twitter className="h-4 w-4" />

                                      </span>                      </Button>

                                    )}                      <Button size="icon" variant="outline">

                                  </div>                        <Mail className="h-4 w-4" />

                                </div>                      </Button>

                              </div>                    </div>

                              {review.text && (                  </div>

                                <p className="text-sm text-gray-600 mt-2">{review.text}</p>                </TabsContent>

                              )}              </Tabs>

                            </div>            </div>

                          </div>          </div>

                        </div>        </ScrollArea>

                      ))}      </SheetContent>

                    </div>    </Sheet>

                  </TabsContent>  )

                )}}

                {/* About Tab */}
                {hasAbout && (
                  <TabsContent value="about" className="mt-6 space-y-6">
                    {listing.description && (
                      <div className="space-y-4">
                        <h3 className="font-semibold text-lg">Business Description</h3>
                        <p className="text-gray-600 leading-relaxed">{listing.description}</p>
                      </div>
                    )}

                    {(listing.website || listing.email) && (
                      <div className="space-y-4">
                        <h3 className="font-semibold text-lg">Online Presence</h3>
                        <div className="space-y-3">
                          {listing.website && (
                            <div className="flex justify-between py-2 border-b">
                              <span className="text-gray-600">Website</span>
                              <a
                                href={listing.website.startsWith('http') ? listing.website : `https://${listing.website}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                className="font-medium text-red-500 hover:text-red-600 hover:underline"
                              >
                                Visit site
                              </a>
                            </div>
                          )}
                          {listing.email && (
                            <div className="flex justify-between py-2 border-b">
                              <span className="text-gray-600">Email</span>
                              <a
                                href={`mailto:${listing.email}`}
                                className="font-medium text-red-500 hover:text-red-600 hover:underline"
                              >
                                {listing.email}
                              </a>
                            </div>
                          )}
                        </div>
                      </div>
                    )}

                    {listing.businessStatus && (
                      <div className="space-y-4">
                        <h3 className="font-semibold text-lg">Status</h3>
                        <Badge 
                          variant={listing.businessStatus === 'OPERATIONAL' ? 'default' : 'secondary'}
                          className={listing.businessStatus === 'OPERATIONAL' ? 'bg-green-500' : ''}
                        >
                          {listing.businessStatus.replace('_', ' ')}
                        </Badge>
                      </div>
                    )}
                  </TabsContent>
                )}
              </Tabs>
            </div>
          </div>
        </ScrollArea>
      </SheetContent>
    </Sheet>
  )
}
