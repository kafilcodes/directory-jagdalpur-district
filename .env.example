# ============================================
# FIREBASE CONFIGURATION (Client)
# ============================================
# These values are the SAME for all cities (single Firebase project)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# FIREBASE ADMIN (Server-side)
# ============================================
# These values are the SAME for all cities (single Firebase project)
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ⚠️ IMPORTANT: Only this changes per city!
# Different Firestore database ID for each city deployment
FIREBASE_DATABASE_ID=dhamtaridirectory
NEXT_PUBLIC_FIREBASE_DATABASE_ID=dhamtaridirectory

# ============================================
# CITY CONFIGURATION
# ============================================
# 🔄 CHANGE THESE for different cities

# Brand & Identity
NEXT_PUBLIC_APP_NAME=Dial Dhamtari
NEXT_PUBLIC_CITY_NAME=Dhamtari
NEXT_PUBLIC_STATE_NAME=Chhattisgarh
NEXT_PUBLIC_STATE_CODE=CG

# Location & Address
NEXT_PUBLIC_CITY_PIN_CODE=493773
NEXT_PUBLIC_OFFICE_PIN_CODE=493776
NEXT_PUBLIC_OFFICE_ADDRESS=NEAR CIVIL COURT RUDRI DISTRICT DHAMTARI C.G.493776

# Map Coordinates (Center of the city)
NEXT_PUBLIC_MAP_CENTER_LAT=21.0278
NEXT_PUBLIC_MAP_CENTER_LNG=81.6300

# Map Boundaries (for validation - city district limits)
NEXT_PUBLIC_MIN_LAT=20.9
NEXT_PUBLIC_MAX_LAT=21.9
NEXT_PUBLIC_MIN_LNG=81.0
NEXT_PUBLIC_MAX_LNG=82.2

# Map Search Radius (in meters)
NEXT_PUBLIC_MAP_RADIUS=30000

# Website & SEO
NEXT_PUBLIC_SITE_URL=https://dhamtari.directory
NEXT_PUBLIC_SITE_DESCRIPTION=Discover trusted local businesses and services in Dhamtari, Chhattisgarh. Browse verified listings, read reviews, and connect with the best providers in your area.
NEXT_PUBLIC_SITE_KEYWORDS=Dial Dhamtari,Dhamtari directory,Dhamtari businesses,local services Dhamtari,business directory Chhattisgarh,Dhamtari local search,find businesses Dhamtari
NEXT_PUBLIC_COPYRIGHT_HOLDER=Dhamtari District Administration

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=odhamtari@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+91-9340897799

# ============================================
# PAYMENT GATEWAY (Razorpay)
# ============================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ============================================
# EXTERNAL APIs
# ============================================
# Google Places API (for business search & autocomplete)
NEXT_GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google AdSense
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=pub-xxxxxxxxxxxxxxxx

# Google Gemini AI (for chatbot)
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# ADMIN PANEL
# ============================================
NEXT_PUBLIC_ADMIN_PASS=YourSecureAdminPassword123!

# ============================================
# DEPLOYMENT GUIDE
# ============================================
# 
# To deploy for a different city:
# 
# 1. Keep ALL Firebase credentials the same (single project)
# 2. Create new Firestore database in Firebase Console:
#    - Go to Firestore → Create Database
#    - Choose Database ID (e.g., "raipurdirectory")
#    - Set to same rules as existing database
# 
# 3. Update ONLY these variables:
#    ✅ FIREBASE_DATABASE_ID
#    ✅ NEXT_PUBLIC_FIREBASE_DATABASE_ID
#    ✅ NEXT_PUBLIC_APP_NAME
#    ✅ NEXT_PUBLIC_CITY_NAME
#    ✅ NEXT_PUBLIC_STATE_NAME
#    ✅ NEXT_PUBLIC_CITY_PIN_CODE
#    ✅ NEXT_PUBLIC_OFFICE_ADDRESS
#    ✅ Map coordinates (LAT, LNG, boundaries)
#    ✅ NEXT_PUBLIC_SITE_URL
#    ✅ NEXT_PUBLIC_SITE_DESCRIPTION
#    ✅ NEXT_PUBLIC_SITE_KEYWORDS
#    ✅ NEXT_PUBLIC_COPYRIGHT_HOLDER
#    ✅ NEXT_PUBLIC_CONTACT_EMAIL
#    ✅ NEXT_PUBLIC_CONTACT_PHONE
# 
# 4. Deploy to new domain/subdomain
# 
# Example for Raipur:
#   FIREBASE_DATABASE_ID=raipurdirectory
#   NEXT_PUBLIC_FIREBASE_DATABASE_ID=raipurdirectory
#   NEXT_PUBLIC_APP_NAME=Dial Raipur
#   NEXT_PUBLIC_CITY_NAME=Raipur
#   NEXT_PUBLIC_CITY_PIN_CODE=492001
#   NEXT_PUBLIC_MAP_CENTER_LAT=21.2514
#   NEXT_PUBLIC_MAP_CENTER_LNG=81.6296
#   NEXT_PUBLIC_SITE_URL=https://raipur.directory
#   ... (update all city-specific values)
