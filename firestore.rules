rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PUBLIC read-only collections
    match /{collection}/{docId} where collection in ['listings', 'categories', 'plans', 'adPlacements'] {
      allow read: if true;
    }

    // Listing owners can write their own listing (dev mode; tighten later)
    match /listings/{listingId} {
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Analytics events: anyone can create (dev mode)
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read, write, delete: if false;
    }
  }
}
